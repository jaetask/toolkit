{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!.claude",
      "!src/ui",
      "!src/icons",
      "!src/design-system",
      "!src/hooks",
      "!src/provider.tsx",
      "!src/utils.ts",
      "!src/styles.css",
      "!src/theme",
      "!src/editor",
      "!src/collab-ui",
      "!src/app",
      "!src/editor.css"
    ]
  },
  "formatter": { "indentStyle": "space", "lineWidth": 100 }
}
