{
  "name": "@jaetask/toolkit",
  "version": "0.3.16",
  "description": "The agent-native toolkit's ui parts, ported with the suite's look, plus the suite's app shell and page kit.",
  "keywords": [
    "react",
    "app-shell",
    "design-system",
    "ux-flow"
  ],
  "author": "jaetask",
  "license": "MIT",
  "homepage": "https://github.com/jaetask/toolkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaetask/toolkit.git"
  },
  "bugs": "https://github.com/jaetask/toolkit/issues",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./ui/*": {
      "types": "./dist/ui/*.d.ts",
      "import": "./dist/ui/*.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    },
    "./design-system": {
      "types": "./dist/design-system/index.d.ts",
      "import": "./dist/design-system/index.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "import": "./dist/editor/index.js"
    },
    "./editor/*": {
      "types": "./dist/editor/*.d.ts",
      "import": "./dist/editor/*.js"
    },
    "./collab-ui": {
      "types": "./dist/collab-ui/index.d.ts",
      "import": "./dist/collab-ui/index.js"
    },
    "./collab-ui/*": {
      "types": "./dist/collab-ui/*.d.ts",
      "import": "./dist/collab-ui/*.js"
    },
    "./app/review": {
      "types": "./dist/app/review/index.d.ts",
      "import": "./dist/app/review/index.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "import": "./dist/provider.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js"
    },
    "./suite": {
      "types": "./dist/suite/index.d.ts",
      "import": "./dist/suite/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./editor.css": "./dist/editor.css",
    "./package.json": "./package.json"
  },
  "bin": {
    "toolkit-guard": "dist/guard.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/finalize-build.mjs && chmod +x dist/guard.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint . && node scripts/check-scrub.mjs && node .agents/guardrails/check-comments.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "tsx --test src/*.test.ts src/suite/*.test.tsx",
    "demo": "tsx scripts/demo.tsx",
    "prepare": "npm run build && (git config core.hooksPath .agents/guardrails/hooks || true)",
    "prebuild": "node scripts/check-install.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@tailwindcss/cli": "4.3.5",
    "@types/culori": "4.0.1",
    "@types/node": "22.18.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  },
